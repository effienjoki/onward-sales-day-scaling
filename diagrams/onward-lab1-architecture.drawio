graph.aws4.systems_manager;" vertex="1" parent="1"><mxGeometry x="1440" y="150" width="60" height="60" as="geometry" /></mxCell><mxCell id="c21" value="Internet&lt;br&gt;gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" vertex="1" parent="1"><mxGeometry x="400" y="560" width="60" height="60" as="geometry" /></mxCell><mxCell id="c22" value="&lt;b&gt;Regional NAT Gateway&lt;/b&gt;&lt;br&gt;no subnet, serves both AZs&lt;br&gt;outbound only" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=middle;labelPosition=right;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.nat_gateway;" vertex="1" parent="1"><mxGeometry x="760" y="415" width="60" height="60" as="geometry" /></mxCell><mxCell id="c23" value="&lt;b&gt;ALB :80&lt;/b&gt; (app stack)&lt;br&gt;health check /health every 15 s" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=middle;labelPosition=left;align=right;verticalAlign=middle;spacingRight=6;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elastic_load_balancing;" vertex="1" parent="1"><mxGeometry x="1010" y="570" width="60" height="60" as="geometry" /></mxCell><mxCell id="c24" value="EC2 t3.micro&lt;br&gt;Java app :8080" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="560" y="760" width="60" height="60" as="geometry" /></mxCell><mxCell id="c25" value="added on&lt;br&gt;sales day" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;opacity=45;" vertex="1" parent="1"><mxGeometry x="700" y="760" width="60" height="60" as="geometry" /></mxCell><mxCell id="c26" value="EC2 t3.micro&lt;br&gt;Java app :8080" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1"><mxGeometry x="1120" y="760" width="60" height="60" as="geometry" /></mxCell><mxCell id="c27" value="added on&lt;br&gt;sales day" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;opacity=45;" vertex="1" parent="1"><mxGeometry x="1290" y="760" width="60" height="60" as="geometry" /></mxCell><mxCell id="c28" value="S3 gateway&lt;br&gt;endpoint" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.endpoints;" vertex="1" parent="1"><mxGeometry x="880" y="760" width="60" height="60" as="geometry" /></mxCell><mxCell id="c29" value="&lt;b&gt;Auto Scaling group&lt;/b&gt; onward-dev-orders-asg (app stack): min 2, max 6, target tracking on CPU 50%, ELB health checks.&lt;br&gt;Launch template: latest Amazon Linux 2023, IMDSv2 required, user data installs Java and runs the app as a non root service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="860" width="1020" height="60" as="geometry" /></mxCell><mxCell id="c30" value="Private route table: 0.0.0.0/0 to the Regional NAT Gateway (outbound only), S3 through the gateway endpoint. No public IPs." style="text;html=1;fontSize=10;fontColor=#147EBA;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="540" y="935" width="440" height="45" as="geometry" /></mxCell><mxCell id="c31" value="Security group: port 8080 from the ALB security group only. No SSH, no admin ports." style="text;html=1;fontSize=10;fontColor=#147EBA;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1100" y="935" width="440" height="45" as="geometry" /></mxCell><mxCell id="c32" value="&lt;b&gt;Customer flow (blue)&lt;/b&gt;&lt;br&gt;Customers to internet gateway to ALB to servers&lt;br&gt;in private subnets&lt;br&gt;&lt;br&gt;&lt;b&gt;Outbound only (green, dashed)&lt;/b&gt;&lt;br&gt;Servers download updates, Java and the app&lt;br&gt;(pinned commit) through the Regional NAT Gateway.&lt;br&gt;Nothing on the internet can start a connection in&lt;br&gt;&lt;br&gt;&lt;b&gt;Scaling (red, dashed)&lt;/b&gt;&lt;br&gt;CloudWatch sees CPU above 50% and Auto Scaling&lt;br&gt;adds servers, up to 6. When CPU falls, it removes&lt;br&gt;them, down to 2. Failed servers are replaced&lt;br&gt;&lt;br&gt;&lt;b&gt;Admin access (purple, dashed)&lt;/b&gt;&lt;br&gt;Session Manager and Run Command through&lt;br&gt;Systems Manager. No SSH, no open ports&lt;br&gt;&lt;br&gt;&lt;b&gt;Deployment (grey)&lt;/b&gt;&lt;br&gt;Git sync deploys the network stack, then the&lt;br&gt;app stack, from the repository" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB7B8;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="320" height="420" as="geometry" /></mxCell><mxCell id="c33" value="Git sync" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#5A6B86;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#5A6B86;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c14" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="350" y="145" /><mxPoint x="350" y="180" /></Array></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#147EBA;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c16" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="550" /><mxPoint x="300" y="590" /></Array></mxGeometry></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#147EBA;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c21" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="590" /><mxPoint x="780" y="600" /></Array></mxGeometry></mxCell><mxCell id="c36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#147EBA;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=11;fontColor=#147EBA;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="695" /><mxPoint x="590" y="695" /></Array></mxGeometry></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#147EBA;strokeWidth=2;das